# PostgreSQL (Neon uses sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/VEYLORIQ?sslmode=require"
# 32+ random characters. TOTP key must decode to exactly 32 bytes.
SESSION_PEPPER="replace-with-a-random-secret-of-at-least-32-characters"
TOTP_ENCRYPTION_KEY="base64-encoded-32-byte-key"
APP_URL="http://localhost:3000"
# Set only when the ingress overwrites this header and strips client input.
TRUSTED_PROXY_IP_HEADER=""
OPERATOR_LEGAL_NAME=""
OPERATOR_TAX_ID=""
OPERATOR_ADDRESS=""
CONTACT_TO_EMAIL=""

# Distributed rate limiting and worker leases. Leave empty only in local development.
REDIS_URL=""

# Brevo transactional mail
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="VEYLORIQ"
BREVO_WEBHOOK_TOKEN="replace-with-a-long-random-bearer-token"

# Cloudinary authenticated/private assets
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLAMAV_SCAN_URL=""
CLAMAV_SCAN_TOKEN=""

# Mercado Pago subscriptions (Peru)
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
BILLING_GRACE_DAYS="7"

# OpenAI-compatible inference
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY=""
AI_MODEL=""

# Used only by the explicit seed command
PLATFORM_BOOTSTRAP_EMAIL=""
PLATFORM_BOOTSTRAP_PASSWORD=""

# Protege /api/cron/worker cuando NO lo invoca Vercel Cron (disparo manual).
# En Vercel, los Cron Jobs envían la cabecera x-vercel-cron y no necesitan este secreto.
CRON_SECRET=""

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=""
LOG_LEVEL="info"
